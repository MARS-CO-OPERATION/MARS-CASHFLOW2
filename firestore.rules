rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 0. GLOBAL CATCH-ALL & CORE HELPER FUNCTIONS
    // =========================================================================

    // Global Safety Net: Default deny all unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return hasUserDoc() && ('primaryRole' in getUserDoc())
        ? getUserDoc().primaryRole
        : '';
    }

    function isLandlord() {
      return isSignedIn() && getUserRole() == 'LANDLORD';
    }

    function isManager() {
      return isSignedIn() && getUserRole() == 'MANAGER';
    }

    function isTenant() {
      return isSignedIn() && (getUserRole() == 'TENANT');
    }

    // Property ownership and management relations
    function isPropertyOwner(propertyId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/properties/$(propertyId)) &&
        get(/databases/$(database)/documents/properties/$(propertyId)).data.ownerUserId == request.auth.uid;
    }

    function isPropertyManager(propertyId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/properties/$(propertyId)) &&
        (
          (('managerIds' in get(/databases/$(database)/documents/properties/$(propertyId)).data) &&
           (request.auth.uid in get(/databases/$(database)/documents/properties/$(propertyId)).data.managerIds)) ||
          (('caretakerPhone' in get(/databases/$(database)/documents/properties/$(propertyId)).data) &&
           request.auth.token.phone_number != null &&
           get(/databases/$(database)/documents/properties/$(propertyId)).data.caretakerPhone == request.auth.token.phone_number)
        );
    }

    function isAuthorizedForProperty(propertyId) {
      return isPropertyOwner(propertyId) || isPropertyManager(propertyId);
    }

    // =========================================================================
    // SCHEMA VALIDATION BLUEPRINTS
    // =========================================================================

    function isValidUser(data) {
      return data.id is string && isValidId(data.id) &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
        data.primaryRole in ['LANDLORD', 'MANAGER', 'TENANT'] &&
        data.accountStatus in ['ACTIVE', 'INACTIVE', 'SUSPENDED'] &&
        (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 32)) &&
        (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 32)) &&
        (!('assignedRoles' in data) || data.assignedRoles is list) &&
        (!('activeContextId' in data) || (data.activeContextId is string && data.activeContextId.size() <= 128)) &&
        (!('authProvider' in data) || data.authProvider in ['GOOGLE', 'PASSWORD', 'PHONE_PIN', 'ANONYMOUS']) &&
        (!('organizationId' in data) || (data.organizationId is string && data.organizationId.size() <= 128)) &&
        (!('language' in data) || data.language in ['en', 'lg', 'sw']) &&
        (!('pinHash' in data) || (data.pinHash is string && data.pinHash.size() <= 128)) &&
        (!('isDemo' in data) || data.isDemo is bool);
    }

    function isValidProperty(data) {
      return data.id is string && isValidId(data.id) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.location is string && data.location.size() <= 150 &&
        data.totalUnits is number && data.totalUnits >= 0 &&
        data.ownerUserId is string && isValidId(data.ownerUserId) &&
        (!('occupancyRate' in data) || data.occupancyRate is number) &&
        (!('caretakerPhone' in data) || (data.caretakerPhone is string && data.caretakerPhone.size() <= 32)) &&
        (!('monthlyRevenue' in data) || data.monthlyRevenue is number) &&
        (!('managerIds' in data) || (data.managerIds is list && data.managerIds.size() <= 50));
    }

    function isValidUnit(data) {
      return data.id is string && isValidId(data.id) &&
        data.propertyId is string && isValidId(data.propertyId) &&
        data.unitName is string && data.unitName.size() > 0 && data.unitName.size() <= 64 &&
        data.monthlyRent is number && data.monthlyRent >= 0 &&
        data.status in ['OCCUPIED', 'VACANT', 'MAINTENANCE'] &&
        (!('unitNumber' in data) || (data.unitNumber is string && data.unitNumber.size() <= 32)) &&
        (!('currentTenantId' in data) || (data.currentTenantId is string && data.currentTenantId.size() <= 128)) &&
        (!('currentTenantName' in data) || (data.currentTenantName is string && data.currentTenantName.size() <= 100)) &&
        (!('tenantUserId' in data) || (data.tenantUserId is string && data.tenantUserId.size() <= 128));
    }

    function isValidTenant(data) {
      return data.id is string && isValidId(data.id) &&
        data.propertyId is string && isValidId(data.propertyId) &&
        data.unitId is string && isValidId(data.unitId) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.phone is string && data.phone.size() <= 32 &&
        data.rentDue is number &&
        data.paymentStatus in ['PAID', 'DUE', 'OVERDUE', 'PARTIAL'] &&
        (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
        (!('arrears' in data) || data.arrears is number) &&
        (!('depositPaid' in data) || data.depositPaid is number) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
        (!('nationalId' in data) || (data.nationalId is string && data.nationalId.size() <= 64)) &&
        (!('emergencyContact' in data) || (data.emergencyContact is string && data.emergencyContact.size() <= 100));
    }

    function isValidPayment(data) {
      return data.id is string && isValidId(data.id) &&
        data.tenantId is string && isValidId(data.tenantId) &&
        data.propertyId is string && isValidId(data.propertyId) &&
        data.amount is number && data.amount > 0 &&
        data.paymentMethod in ['MTN_MOMO', 'AIRTEL_MONEY', 'CASH', 'BANK_TRANSFER'] &&
        data.recordedByUserId is string && isValidId(data.recordedByUserId) &&
        (!('receiptNumber' in data) || (data.receiptNumber is string && data.receiptNumber.size() <= 64)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
        (!('transactionRef' in data) || (data.transactionRef is string && data.transactionRef.size() <= 100)) &&
        (!('syncStatus' in data) || data.syncStatus in ['SYNCED', 'PENDING', 'FAILED']) &&
        (!('reversalReason' in data) || (data.reversalReason is string && data.reversalReason.size() <= 255)) &&
        (!('isReconciled' in data) || data.isReconciled is bool);
    }

    function isValidExpense(data) {
      return data.id is string && isValidId(data.id) &&
        data.propertyId is string && isValidId(data.propertyId) &&
        data.category is string && data.category.size() <= 64 &&
        data.amount is number && data.amount > 0 &&
        data.recordedByUserId is string && isValidId(data.recordedByUserId) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
        (!('vendor' in data) || (data.vendor is string && data.vendor.size() <= 120));
    }

    function isValidMaintenance(data) {
      return data.id is string && isValidId(data.id) &&
        data.propertyId is string && isValidId(data.propertyId) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
        data.priority in ['Low', 'Medium', 'High', 'Emergency', 'LOW', 'MEDIUM', 'HIGH', 'EMERGENCY'] &&
        data.status in ['Pending', 'In Progress', 'Resolved', 'Cancelled', 'PENDING', 'IN_PROGRESS', 'RESOLVED', 'CANCELLED'] &&
        (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
        (!('assignedProviderId' in data) || (data.assignedProviderId is string && data.assignedProviderId.size() <= 128)) &&
        (!('estimatedCost' in data) || data.estimatedCost is number) &&
        (!('actualCost' in data) || data.actualCost is number) &&
        (!('completionNotes' in data) || (data.completionNotes is string && data.completionNotes.size() <= 500));
    }

    function isValidReceipt(data) {
      return data.id is string && isValidId(data.id) &&
        data.paymentId is string && isValidId(data.paymentId) &&
        data.receiptNumber is string && data.receiptNumber.size() <= 64 &&
        data.tenantId is string && isValidId(data.tenantId) &&
        data.propertyId is string && isValidId(data.propertyId) &&
        data.amount is number && data.amount > 0 &&
        data.qrVerificationCode is string && data.qrVerificationCode.size() <= 255;
    }

    function isValidAuditEvent(data) {
      return data.id is string && isValidId(data.id) &&
        data.actorUserId is string && isValidId(data.actorUserId) &&
        data.eventType is string && data.eventType.size() <= 100 &&
        data.resourceType is string && data.resourceType.size() <= 100 &&
        data.resourceId is string && data.resourceId.size() <= 128 &&
        data.details is string && data.details.size() <= 1000;
    }

    function isValidServiceProvider(data) {
      return data.id is string && isValidId(data.id) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.phone is string && data.phone.size() <= 32 &&
        data.serviceType in ['Plumbing', 'Electrical', 'Security', 'Fumigation', 'General', 'Masonry', 'Painting'] &&
        data.status in ['Available', 'On Job', 'Unavailable'] &&
        (!('rate' in data) || (data.rate is string && data.rate.size() <= 100)) &&
        (!('assignedProperty' in data) || (data.assignedProperty is string && data.assignedProperty.size() <= 120));
    }

    // =========================================================================
    // 1. USER PROFILES & ACCOUNTS
    // =========================================================================
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isLandlord() || isManager());
      allow list: if isSignedIn() && (isLandlord() || isManager());
      // Only Landlords can self-register. Managers and Tenants are provisioned by Landlords.
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming()) && (incoming().primaryRole == 'LANDLORD' || isLandlord());
      allow update: if isSignedIn() && isValidUser(incoming()) && (
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'phoneNumber', 'displayName', 'phone', 'language', 'activeContextId', 'updatedAt', 'pinHash', 'assignedRoles'])) ||
        (isLandlord() && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'phoneNumber', 'displayName', 'phone', 'language', 'activeContextId', 'updatedAt', 'pinHash', 'assignedRoles', 'primaryRole', 'accountStatus', 'organizationId']))
      );
      allow delete: if false; // Strict soft-deactivation only
    }

    match /role_assignments/{assignmentId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isLandlord() || isManager());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isLandlord() || isManager());
      allow create: if isSignedIn() && (request.auth.uid == incoming().userId || isLandlord());
      allow update: if isSignedIn() && (isLandlord() || request.auth.uid == existing().userId);
      allow delete: if isSignedIn() && isLandlord();
    }

    // =========================================================================
    // 2. PROPERTIES
    // =========================================================================
    match /properties/{propertyId} {
      allow get: if isSignedIn() && isValidId(propertyId) && (
        resource.data.ownerUserId == request.auth.uid ||
        (('managerIds' in resource.data) && request.auth.uid in resource.data.managerIds) ||
        isPropertyOwner(propertyId) ||
        isLandlord()
      );
      allow list: if isSignedIn() && (
        resource.data.ownerUserId == request.auth.uid ||
        (('managerIds' in resource.data) && request.auth.uid in resource.data.managerIds)
      );
      allow create: if isSignedIn() && isValidId(propertyId) &&
        (isLandlord() || isManager()) &&
        incoming().ownerUserId == request.auth.uid &&
        isValidProperty(incoming());
      allow update: if isSignedIn() && isValidId(propertyId) && isValidProperty(incoming()) && (
        (resource.data.ownerUserId == request.auth.uid && incoming().ownerUserId == existing().ownerUserId) ||
        (isPropertyManager(propertyId) && incoming().diff(existing()).affectedKeys().hasOnly(['occupancyRate', 'caretakerPhone', 'monthlyRevenue']))
      );
      allow delete: if isSignedIn() && isValidId(propertyId) && resource.data.ownerUserId == request.auth.uid;
    }

    // =========================================================================
    // 3. UNITS
    // =========================================================================
    match /units/{unitId} {
      allow get: if isSignedIn() && isValidId(unitId) && (
        isAuthorizedForProperty(resource.data.propertyId) ||
        (('tenantUserId' in resource.data) && resource.data.tenantUserId == request.auth.uid) ||
        (('currentTenantId' in resource.data) && resource.data.currentTenantId == request.auth.uid)
      );
      allow list: if isSignedIn() && (
        isAuthorizedForProperty(resource.data.propertyId) ||
        (('tenantUserId' in resource.data) && resource.data.tenantUserId == request.auth.uid) ||
        (('currentTenantId' in resource.data) && resource.data.currentTenantId == request.auth.uid)
      );
      allow create: if isSignedIn() && isValidId(unitId) &&
        isAuthorizedForProperty(incoming().propertyId) &&
        isValidUnit(incoming());
      allow update: if isSignedIn() && isValidId(unitId) && isValidUnit(incoming()) && (
        (isPropertyOwner(existing().propertyId) && incoming().propertyId == existing().propertyId) ||
        (isPropertyManager(existing().propertyId) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'currentTenantId', 'currentTenantName', 'tenantUserId']))
      );
      allow delete: if isSignedIn() && isValidId(unitId) && isPropertyOwner(resource.data.propertyId);
    }

    // =========================================================================
    // 4. TENANTS & LEASE REGISTRY
    // =========================================================================
    match /tenants/{tenantId} {
      allow get: if isSignedIn() && isValidId(tenantId) && (
        resource.data.id == request.auth.uid ||
        (('userId' in resource.data) && resource.data.userId == request.auth.uid) ||
        isAuthorizedForProperty(resource.data.propertyId)
      );
      allow list: if isSignedIn() && (
        resource.data.id == request.auth.uid ||
        (('userId' in resource.data) && resource.data.userId == request.auth.uid) ||
        isLandlord() ||
        isManager()
      );
      allow create: if isSignedIn() && isValidId(tenantId) &&
        isAuthorizedForProperty(incoming().propertyId) &&
        isValidTenant(incoming());
      allow update: if isSignedIn() && isValidId(tenantId) && isValidTenant(incoming()) && (
        (isAuthorizedForProperty(existing().propertyId) && incoming().propertyId == existing().propertyId) ||
        ((('userId' in existing()) && existing().userId == request.auth.uid) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['phone', 'email', 'name', 'emergencyContact']))
      );
      allow delete: if isSignedIn() && isValidId(tenantId) && isPropertyOwner(resource.data.propertyId);
    }

    // =========================================================================
    // 5. FINANCIAL INFLOWS: PAYMENTS (IMMUTABLE LEDGER)
    // =========================================================================
    match /payments/{paymentId} {
      allow get: if isSignedIn() && isValidId(paymentId) && (
        resource.data.tenantId == request.auth.uid ||
        resource.data.recordedByUserId == request.auth.uid ||
        isAuthorizedForProperty(resource.data.propertyId)
      );
      allow list: if isSignedIn() && (
        resource.data.tenantId == request.auth.uid ||
        resource.data.recordedByUserId == request.auth.uid ||
        isAuthorizedForProperty(resource.data.propertyId)
      );
      allow create: if isSignedIn() && isValidId(paymentId) &&
        (
          isAuthorizedForProperty(incoming().propertyId) ||
          (incoming().tenantId == request.auth.uid && incoming().paymentMethod in ['MTN_MOMO', 'AIRTEL_MONEY', 'BANK_TRANSFER'])
        ) &&
        isValidPayment(incoming());
      // Immutable ledger: Financial amount and tenant cannot be altered
      allow update: if isSignedIn() && isValidId(paymentId) &&
        isValidPayment(incoming()) &&
        isPropertyOwner(existing().propertyId) &&
        incoming().amount == existing().amount &&
        incoming().tenantId == existing().tenantId &&
        incoming().propertyId == existing().propertyId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['syncStatus', 'reversalReason', 'isReconciled']);
      allow delete: if false; // Strict prohibition on payment deletion
    }

    // =========================================================================
    // 6. FINANCIAL OUTFLOWS: EXPENSES
    // =========================================================================
    match /expenses/{expenseId} {
      allow get: if isSignedIn() && isValidId(expenseId) && isAuthorizedForProperty(resource.data.propertyId);
      allow list: if isSignedIn() && (
        resource.data.recordedByUserId == request.auth.uid ||
        isLandlord() ||
        isManager()
      );
      allow create: if isSignedIn() && isValidId(expenseId) &&
        (isAuthorizedForProperty(incoming().propertyId) || isLandlord() || isManager()) &&
        incoming().recordedByUserId == request.auth.uid &&
        isValidExpense(incoming());
      allow update: if isSignedIn() && isValidId(expenseId) &&
        isValidExpense(incoming()) &&
        isAuthorizedForProperty(existing().propertyId) &&
        incoming().propertyId == existing().propertyId;
      allow delete: if isSignedIn() && isValidId(expenseId) && isPropertyOwner(resource.data.propertyId);
    }

    // =========================================================================
    // 7. MAINTENANCE TICKETS & SERVICE DISPATCHES
    // =========================================================================
    match /maintenance/{ticketId} {
      allow get: if isSignedIn() && isValidId(ticketId) && (
        (('tenantId' in resource.data) && resource.data.tenantId == request.auth.uid) ||
        (('assignedProviderId' in resource.data) && resource.data.assignedProviderId == request.auth.uid) ||
        isAuthorizedForProperty(resource.data.propertyId)
      );
      allow list: if isSignedIn() && (
        (('tenantId' in resource.data) && resource.data.tenantId == request.auth.uid) ||
        (('assignedProviderId' in resource.data) && resource.data.assignedProviderId == request.auth.uid) ||
        isLandlord() ||
        isManager()
      );
      allow create: if isSignedIn() && isValidId(ticketId) &&
        (
          (('tenantId' in incoming()) && incoming().tenantId == request.auth.uid) ||
          isAuthorizedForProperty(incoming().propertyId)
        ) &&
        isValidMaintenance(incoming());
      allow update: if isSignedIn() && isValidId(ticketId) && isValidMaintenance(incoming()) && (
        (isAuthorizedForProperty(existing().propertyId) && incoming().propertyId == existing().propertyId) ||
        ((('assignedProviderId' in existing()) && existing().assignedProviderId == request.auth.uid) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'completionNotes', 'completedAt', 'actualCost', 'notes']))
      );
      allow delete: if isSignedIn() && isValidId(ticketId) && isPropertyOwner(resource.data.propertyId);
    }

    match /maintenance_tickets/{ticketId} {
      allow get: if isSignedIn() && isValidId(ticketId) && (
        (('tenantId' in resource.data) && resource.data.tenantId == request.auth.uid) ||
        (('assignedProviderId' in resource.data) && resource.data.assignedProviderId == request.auth.uid) ||
        isAuthorizedForProperty(resource.data.propertyId)
      );
      allow list: if isSignedIn() && (
        (('tenantId' in resource.data) && resource.data.tenantId == request.auth.uid) ||
        (('assignedProviderId' in resource.data) && resource.data.assignedProviderId == request.auth.uid) ||
        isLandlord() ||
        isManager()
      );
      allow create: if isSignedIn() && isValidId(ticketId) &&
        (
          (('tenantId' in incoming()) && incoming().tenantId == request.auth.uid) ||
          isAuthorizedForProperty(incoming().propertyId)
        ) &&
        isValidMaintenance(incoming());
      allow update: if isSignedIn() && isValidId(ticketId) && isValidMaintenance(incoming()) && (
        (isAuthorizedForProperty(existing().propertyId) && incoming().propertyId == existing().propertyId) ||
        ((('assignedProviderId' in existing()) && existing().assignedProviderId == request.auth.uid) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'completionNotes', 'completedAt', 'actualCost', 'notes']))
      );
      allow delete: if isSignedIn() && isValidId(ticketId) && isPropertyOwner(resource.data.propertyId);
    }

    // =========================================================================
    // 8. DIGITAL RECEIPTS (IMMUTABLE PROOF OF PAYMENT)
    // =========================================================================
    match /receipts/{receiptId} {
      allow get: if isSignedIn() && isValidId(receiptId) && (
        resource.data.tenantId == request.auth.uid ||
        isAuthorizedForProperty(resource.data.propertyId)
      );
      allow list: if isSignedIn() && (
        resource.data.tenantId == request.auth.uid ||
        isLandlord() ||
        isManager()
      );
      allow create: if isSignedIn() && isValidId(receiptId) &&
        isAuthorizedForProperty(incoming().propertyId) &&
        isValidReceipt(incoming());
      allow update, delete: if false; // Receipts are tamper-proof and immutable
    }

    // =========================================================================
    // 9. AUDIT LOGS & EVENT JOURNAL (APPEND-ONLY)
    // =========================================================================
    match /audit_events/{eventId} {
      allow get: if isSignedIn() && isValidId(eventId) && isLandlord();
      allow list: if isSignedIn() && isLandlord();
      allow create: if isSignedIn() && isValidId(eventId) &&
        incoming().actorUserId == request.auth.uid &&
        isValidAuditEvent(incoming());
      allow update, delete: if false; // Audit logs are immutable
    }

    match /auditLogs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && isLandlord();
      allow list: if isSignedIn() && isLandlord();
      allow create: if isSignedIn() && isValidId(logId) &&
        incoming().actorUserId == request.auth.uid &&
        isValidAuditEvent(incoming());
      allow update, delete: if false;
    }

    // =========================================================================
    // 10. SERVICE PROVIDERS DIRECTORY
    // =========================================================================
    match /service_providers/{providerId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(providerId) &&
        (isLandlord() || isManager()) &&
        isValidServiceProvider(incoming());
      allow update: if isSignedIn() && isValidId(providerId) &&
        isValidServiceProvider(incoming()) &&
        (isLandlord() || isManager());
      allow delete: if isSignedIn() && isValidId(providerId) && isLandlord();
    }

    match /serviceProviders/{providerId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(providerId) &&
        (isLandlord() || isManager()) &&
        isValidServiceProvider(incoming());
      allow update: if isSignedIn() && isValidId(providerId) &&
        isValidServiceProvider(incoming()) &&
        (isLandlord() || isManager());
      allow delete: if isSignedIn() && isValidId(providerId) && isLandlord();
    }
  }
}
