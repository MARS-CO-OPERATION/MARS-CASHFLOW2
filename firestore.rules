rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================
    // HELPER FUNCTIONS
    // ==========================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? getUserDoc().primaryRole
        : (request.auth.token.role != null ? request.auth.token.role : '');
    }

    function isLandlord() {
      return getUserRole() == 'LANDLORD' || getUserRole() == 'MULTIROLE' || getUserRole() == 'ADMIN';
    }

    function isManager() {
      return getUserRole() == 'MANAGER' || getUserRole() == 'MULTIROLE' || getUserRole() == 'ADMIN';
    }

    function isContractor() {
      return getUserRole() == 'CONTRACTOR' || getUserRole() == 'SERVICE_PROVIDER';
    }

    function isTenant() {
      return getUserRole() == 'TENANT';
    }

    // Property ownership verification: checks ownerUserId, landlordId, or ownerId
    function isPropertyOwner(propertyId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/properties/$(propertyId)) &&
        (
          get(/databases/$(database)/documents/properties/$(propertyId)).data.ownerUserId == request.auth.uid ||
          get(/databases/$(database)/documents/properties/$(propertyId)).data.landlordId == request.auth.uid ||
          get(/databases/$(database)/documents/properties/$(propertyId)).data.ownerId == request.auth.uid
        );
    }

    // Property manager check: checks managerIds array or managerPhone
    function isPropertyManager(propertyId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/properties/$(propertyId)) &&
        (
          (get(/databases/$(database)/documents/properties/$(propertyId)).data.managerIds != null &&
           request.auth.uid in get(/databases/$(database)/documents/properties/$(propertyId)).data.managerIds) ||
          (get(/databases/$(database)/documents/properties/$(propertyId)).data.managerPhone != null &&
           get(/databases/$(database)/documents/properties/$(propertyId)).data.managerPhone == request.auth.token.phone_number)
        );
    }

    function isAuthorizedForProperty(propertyId) {
      return isPropertyOwner(propertyId) || isPropertyManager(propertyId);
    }

    // ==========================================================
    // 1. USER PROFILES
    // ==========================================================
    // Users can read & write their own account; Landlords & Managers can view profiles
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        isLandlord() ||
        isManager()
      );
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (
        request.auth.uid == userId ||
        isLandlord()
      );
      allow delete: if false; // Soft-delete / account deactivation only
    }

    // ==========================================================
    // 2. ROLE & WORKSPACE ASSIGNMENTS
    // ==========================================================
    match /role_assignments/{assignmentId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isLandlord() ||
        isManager()
      );
      allow write: if isAuthenticated() && (isLandlord() || request.auth.uid == request.resource.data.userId);
    }
    match /roleAssignments/{assignmentId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isLandlord() ||
        isManager()
      );
      allow write: if isAuthenticated() && (isLandlord() || request.auth.uid == request.resource.data.userId);
    }

    // ==========================================================
    // 3. PROPERTIES
    // ==========================================================
    // Landlords can only create/access/delete their assigned properties
    match /properties/{propertyId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerUserId == request.auth.uid ||
        resource.data.landlordId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        (resource.data.managerIds != null && request.auth.uid in resource.data.managerIds) ||
        isPropertyOwner(propertyId)
      );
      allow create: if isAuthenticated() && (
        isLandlord() || isManager()
      ) && (
        request.resource.data.ownerUserId == request.auth.uid ||
        request.resource.data.landlordId == request.auth.uid ||
        request.resource.data.ownerId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        resource.data.ownerUserId == request.auth.uid ||
        resource.data.landlordId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        isPropertyManager(propertyId)
      );
      allow delete: if isAuthenticated() && (
        resource.data.ownerUserId == request.auth.uid ||
        resource.data.landlordId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid
      );
    }

    // ==========================================================
    // 4. UNITS
    // ==========================================================
    match /units/{unitId} {
      allow read: if isAuthenticated() && (
        isAuthorizedForProperty(resource.data.propertyId) ||
        resource.data.currentTenantId == request.auth.uid ||
        resource.data.tenantUserId == request.auth.uid
      );
      allow create, update: if isAuthenticated() && isAuthorizedForProperty(request.resource.data.propertyId);
      allow delete: if isAuthenticated() && isPropertyOwner(resource.data.propertyId);
    }

    // ==========================================================
    // 5. TENANTS & LEASES
    // ==========================================================
    match /tenants/{tenantId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.id == request.auth.uid ||
        (resource.data.phone != null && resource.data.phone == request.auth.token.phone_number) ||
        isAuthorizedForProperty(resource.data.propertyId)
      );
      allow create: if isAuthenticated() && (
        isAuthorizedForProperty(request.resource.data.propertyId) ||
        request.resource.data.userId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        isAuthorizedForProperty(resource.data.propertyId) ||
        (resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone', 'email', 'name']))
      );
      allow delete: if isAuthenticated() && isPropertyOwner(resource.data.propertyId);
    }

    match /leases/{leaseId} {
      allow read: if isAuthenticated() && (
        resource.data.tenantId == request.auth.uid ||
        isAuthorizedForProperty(resource.data.propertyId)
      );
      allow create, update: if isAuthenticated() && isAuthorizedForProperty(request.resource.data.propertyId);
      allow delete: if isAuthenticated() && isPropertyOwner(resource.data.propertyId);
    }

    // ==========================================================
    // 6. FINANCIAL INFLOWS: PAYMENTS (IMMUTABLE LEDGER)
    // ==========================================================
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.tenantId == request.auth.uid ||
        resource.data.recordedByUserId == request.auth.uid ||
        isAuthorizedForProperty(resource.data.propertyId)
      );
      allow create: if isAuthenticated() && (
        isAuthorizedForProperty(request.resource.data.propertyId) ||
        (request.resource.data.tenantId == request.auth.uid && request.resource.data.paymentMethod in ['MTN_MOMO', 'AIRTEL_MONEY', 'BANK_TRANSFER'])
      );
      // Immutable: Only status/reversal fields can be updated by authorized property owners
      allow update: if isAuthenticated() && isPropertyOwner(resource.data.propertyId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['syncStatus', 'reversalReason', 'paymentStatus', 'isReconciled']);
      allow delete: if false;
    }

    // ==========================================================
    // 7. FINANCIAL OUTFLOWS: EXPENSES
    // ==========================================================
    match /expenses/{expenseId} {
      allow read: if isAuthenticated() && isAuthorizedForProperty(resource.data.propertyId);
      allow create: if isAuthenticated() && (
        isAuthorizedForProperty(request.resource.data.propertyId) ||
        isManager() || isLandlord()
      );
      allow update: if isAuthenticated() && isAuthorizedForProperty(resource.data.propertyId);
      allow delete: if isAuthenticated() && isPropertyOwner(resource.data.propertyId);
    }

    // ==========================================================
    // 8. MAINTENANCE & DISPATCH TICKETS
    // ==========================================================
    match /maintenance/{ticketId} {
      allow read: if isAuthenticated() && (
        resource.data.tenantId == request.auth.uid ||
        resource.data.assignedProviderId == request.auth.uid ||
        isAuthorizedForProperty(resource.data.propertyId)
      );
      allow create: if isAuthenticated() && (
        request.resource.data.tenantId == request.auth.uid ||
        isAuthorizedForProperty(request.resource.data.propertyId)
      );
      allow update: if isAuthenticated() && (
        isAuthorizedForProperty(resource.data.propertyId) ||
        (resource.data.assignedProviderId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completionNotes', 'completedAt', 'actualCost', 'notes']))
      );
      allow delete: if isAuthenticated() && isPropertyOwner(resource.data.propertyId);
    }

    match /maintenance_tickets/{ticketId} {
      allow read: if isAuthenticated() && (
        resource.data.tenantId == request.auth.uid ||
        resource.data.assignedProviderId == request.auth.uid ||
        isAuthorizedForProperty(resource.data.propertyId)
      );
      allow create: if isAuthenticated() && (
        request.resource.data.tenantId == request.auth.uid ||
        isAuthorizedForProperty(request.resource.data.propertyId)
      );
      allow update: if isAuthenticated() && (
        isAuthorizedForProperty(resource.data.propertyId) ||
        (resource.data.assignedProviderId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completionNotes', 'completedAt', 'actualCost', 'notes']))
      );
      allow delete: if isAuthenticated() && isPropertyOwner(resource.data.propertyId);
    }

    // ==========================================================
    // 9. DIGITAL RECEIPTS (IMMUTABLE PROOF OF PAYMENT)
    // ==========================================================
    match /receipts/{receiptId} {
      allow read: if isAuthenticated() && (
        resource.data.tenantId == request.auth.uid ||
        isAuthorizedForProperty(resource.data.propertyId)
      );
      allow create: if isAuthenticated() && isAuthorizedForProperty(request.resource.data.propertyId);
      allow update, delete: if false; // Receipts cannot be altered once issued
    }

    // ==========================================================
    // 10. AUDIT LOGS & EVENT JOURNAL (APPEND-ONLY)
    // ==========================================================
    match /audit_events/{eventId} {
      allow read: if isAuthenticated() && isLandlord();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Audit trail is strictly immutable
    }

    match /auditLogs/{logId} {
      allow read: if isAuthenticated() && isLandlord();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ==========================================================
    // 11. SERVICE PROVIDERS DIRECTORY
    // ==========================================================
    match /service_providers/{providerId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isLandlord() || request.auth.uid == providerId);
    }

    match /serviceProviders/{providerId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isLandlord() || request.auth.uid == providerId);
    }
  }
}
