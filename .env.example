# Production Environment
VITE_APP_ENV=production

# Google Maps Platform (Visualization of rental property portfolios)
VITE_GOOGLE_MAPS_API_KEY=

# Firebase Client Configuration (Required for Vercel and Production Deployments)
# Obtained from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
